# Rejara Mobile Application Environment Variables
# NOTE: Prefix all public variables accessible to Expo with EXPO_PUBLIC_
# NEVER store backend secrets or service account keys in mobile environment files.

# API Base URL (e.g., https://api.rejara.com/v1 or http://localhost:8000/api/v1 for local testing)
EXPO_PUBLIC_API_URL=https://api.rejara.com/v1

# Environment Name: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Google OAuth Client IDs (Public client identifiers, not secrets)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Firebase Web App Config (Public client config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=


# Rejara Mobile Application Environment Variables
# Matches backend services from Rejara web application

# Core API Base URL
EXPO_PUBLIC_API_URL=https://api.rejara.com

# Service-Specific URLs (for local backend development or microservice routing)
# Auth Service (Web default port: 1111)
EXPO_PUBLIC_AUTH_URL=http://localhost:1111
# Guidance & Ask Rejara Service (Web default port: 8000)
EXPO_PUBLIC_GUIDANCE_URL=http://localhost:8000
# Tasks & Invites Service (Web default port: 1113)
EXPO_PUBLIC_INVITE_URL=http://localhost:1113
# AI Service (Web default port: 1114)
EXPO_PUBLIC_AI_URL=http://localhost:1114
# Stochastic / Context Service (Web default port: 8080)
EXPO_PUBLIC_STOCHASTIC_URL=http://localhost:8080

# Environment Name: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Google OAuth Client IDs (Public client identifiers, not secrets)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Firebase Client Configuration (from Rejara Firebase Project)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

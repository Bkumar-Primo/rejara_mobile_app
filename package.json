{
  "name": "rejara_mobile_app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "expo-doctor": "^1.21.5",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "test": "jest --watchman=false",
    "check": "biome check src __tests__ app.config.ts",
    "check:fix": "biome check --write src __tests__ app.config.ts",
    "doctor": "expo-doctor",
    "prepare": "lefthook install"
  },
  "overrides": {
    "hermes-parser": "0.36.1"
  },
  "private": true
}
